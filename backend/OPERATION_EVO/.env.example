# Flask
SECRET_KEY=change-this-demo-secret
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
DISABLE_EMAIL_WORKER=true

# Comptes de démonstration créés automatiquement au premier démarrage
DEMO_ADMIN_EMAIL=admin@operation-evo.local
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_AGENT_EMAIL=agent@operation-evo.local
DEMO_AGENT_PASSWORD=Agent123!

# IA Mistral (facultatif : une logique heuristique fonctionne sans clé)
MISTRAL_API_KEY=

# Email (facultatif : l'envoi est simulé si SMTP n'est pas configuré)
SYSTEM_EMAIL_RECIPIENT=support@operation-evo.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
